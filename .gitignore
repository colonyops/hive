# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
!Dockerfile.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/


# Go workspace file
go.work
dist/
.data/
./dev.log
agent-deck/
diffnav
site/
# The site's Python environment and Zensical's cache (docs/)
.venv/
.cache/

# Hive Desktop (cmd/desktop)
.DS_Store
*.log
bin/
node_modules/
# `wails3 generate bindings` stages into a temp directory beside the frontend
# and swaps it into cmd/desktop/frontend/bindings/. An interrupted run leaves
# one behind, and it is 68 files a `git add -A` will take.
cmd/desktop/frontend/.bindings-tmp-*/
# Local env
.env
launch.env
launch.onboarding.env
overrides.env
.mcp.json
.hive-desktop/
.hive-desktop-onboarding/
.hive-desktop.lock/
.hive-desktop.lock.stale.*/
.hive-desktop-onboarding.lock/
.hive-desktop-onboarding.lock.stale.*/
# Binaries `go build ./cmd/<name>` drops in the repo root
/hive
/cmd/hive/hive
/adr
/devserver
/devtools
/release
