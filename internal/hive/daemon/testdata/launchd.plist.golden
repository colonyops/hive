<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.colonyops.hive.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/hive/bin/hive</string>
		<string>daemon</string>
		<string>run</string>
		<string>--wait-lock</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HIVE_CONFIG</key>
		<string>/home/ada/.config/hive/config &amp; 100%.yaml</string>
		<key>HIVE_DATA_DIR</key>
		<string>/home/ada/.local/share/hive</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/home/ada/.local/share/hive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/home/ada/.local/share/hive/logs/hived.out</string>
	<key>StandardErrorPath</key>
	<string>/home/ada/.local/share/hive/logs/hived.out</string>
</dict>
</plist>
