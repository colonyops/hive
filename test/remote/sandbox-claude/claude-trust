#!/usr/bin/env python3
"""Mark the current directory trusted for Claude Code. Trust does not carry
down from a parent directory, so each session's checkout needs its own entry.
"""
import json
import os

path = os.path.expanduser("~/.claude.json")
with open(path) as f:
    state = json.load(f)
state.setdefault("projects", {}).setdefault(os.getcwd(), {})["hasTrustDialogAccepted"] = True
with open(path, "w") as f:
    json.dump(state, f)
