{
  "name": "a feed only claims membership; a notify node is what interrupts",
  "why": "Two things are pinned here. A feed emits exactly one output per message — the membership claim — whatever else the flow wants announced. And a snapshot item reaches the feed but is dropped before the notify terminal: re-announcing the whole feed on every poll is exactly what the snapshot rule exists to prevent.",
  "flow": {
    "id": "loud",
    "name": "Loud",
    "enabled": true,
    "nodes": [
      { "id": "src", "type": "sources.github", "kind": "notifications" },
      { "id": "f", "type": "feed" },
      { "id": "n", "type": "notify", "title": "Ping" }
    ],
    "wires": [
      { "from": "src", "to": "f" },
      { "from": "src", "to": "n" }
    ]
  },
  "batch": [
    {
      "ID": "1", "Key": "k1", "Topic": "source:loud/src", "Ts": 1, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "notifications", "OccurrenceKey": "oc-1",
      "Payload": { "title": "hello" }
    },
    {
      "ID": "2", "Key": "", "Topic": "source:loud/src", "Ts": 2,
      "SourceKind": "github", "SourceScope": "notifications",
      "Payload": [{ "key": "k1", "payload": { "title": "hello" } }],
      "Snapshot": [{ "key": "k1", "payload": { "title": "hello" } }]
    }
  ],
  "expected": {
    "consumer": "loud",
    "upToOffset": 2,
    "outputs": [
      {
        "sink": { "kind": "feed", "targetId": "loud/f" },
        "key": "k1", "payload": { "title": "hello" }, "sourceKind": "github", "sourceScope": "notifications",
        "sourceTopic": "source:loud/src"
      },
      {
        "sink": { "kind": "feed", "targetId": "loud/f" },
        "key": "k1", "payload": { "title": "hello" }, "sourceKind": "github", "sourceScope": "notifications",
        "sourceTopic": "source:loud/src", "snapshotId": "2"
      },
      {
        "sink": { "kind": "notify", "targetId": "loud/n" },
        "key": "k1", "occurrenceKey": "oc-1", "payload": { "title": "hello" },
        "sourceKind": "github", "sourceScope": "notifications",
        "sourceTopic": "source:loud/src"
      }
    ],
    "feedSnapshots": [
      { "feedId": "loud/f", "sourceTopic": "source:loud/src", "snapshotId": "2" }
    ],
    "discards": [{ "msgId": "2", "nodeId": "n" }],
    "nodeRuns": [
      { "flowId": "loud", "nodeId": "src", "ok": true, "inCount": 2, "outCount": 2, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "loud", "nodeId": "f", "ok": true, "inCount": 2, "outCount": 2, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "loud", "nodeId": "n", "ok": true, "inCount": 2, "outCount": 1, "dropCount": 1, "err": "", "durMs": 0 }
    ]
  }
}
