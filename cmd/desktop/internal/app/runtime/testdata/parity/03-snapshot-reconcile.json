{
  "name": "a source snapshot expands into items, declares a feed scope, and never reaches a side-effecting terminal",
  "why": "A snapshot restates every current item on every poll. Its items must route to feeds so obsolete membership can be reconciled away, and must be stopped at action and notify terminals — letting one through would re-run an action, or re-announce an item the user has already seen, on every single poll.",
  "flow": {
    "id": "snap",
    "name": "Snap",
    "enabled": true,
    "nodes": [
      { "id": "gh", "type": "sources.github", "kind": "search", "query": "is:open" },
      { "id": "inbox", "type": "feed" },
      { "id": "run", "type": "action", "action": "triage-it" }
    ],
    "wires": [
      { "from": "gh", "to": "inbox" },
      { "from": "gh", "to": "run" }
    ]
  },
  "batch": [
    {
      "ID": "20",
      "Key": "",
      "Topic": "source:snap/gh",
      "Ts": 1,
      "Payload": [{ "key": "a", "payload": { "n": 1 } }, { "key": "b", "payload": { "n": 2 } }],
      "Snapshot": [{ "key": "a", "payload": { "n": 1 } }, { "key": "b", "payload": { "n": 2 } }],
      "SourceKind": "github",
      "SourceScope": "search"
    },
    {
      "ID": "21",
      "Key": "c",
      "Topic": "source:snap/gh",
      "Ts": 2,
      "Payload": { "n": 3 },
      "Snapshot": null,
      "SourceKind": "github",
      "SourceScope": "search",
      "OccurrenceKey": "oc-c"
    }
  ],
  "expected": {
    "consumer": "snap",
    "upToOffset": 21,
    "outputs": [
      {
        "sink": { "kind": "feed", "targetId": "snap/inbox" },
        "key": "a", "payload": { "n": 1 }, "sourceKind": "github", "sourceScope": "search",
        "sourceTopic": "source:snap/gh", "snapshotId": "20"
      },
      {
        "sink": { "kind": "feed", "targetId": "snap/inbox" },
        "key": "b", "payload": { "n": 2 }, "sourceKind": "github", "sourceScope": "search",
        "sourceTopic": "source:snap/gh", "snapshotId": "20"
      },
      {
        "sink": { "kind": "feed", "targetId": "snap/inbox" },
        "key": "c", "payload": { "n": 3 }, "sourceKind": "github", "sourceScope": "search",
        "sourceTopic": "source:snap/gh"
      },
      {
        "sink": { "kind": "action", "targetId": "triage-it" },
        "key": "c", "occurrenceKey": "oc-c",
        "payload": { "n": 3 },
        "sourceKind": "github", "sourceScope": "search",
        "sourceTopic": ""
      }
    ],
    "feedSnapshots": [
      { "feedId": "snap/inbox", "sourceTopic": "source:snap/gh", "snapshotId": "20" }
    ],
    "discards": [
      { "msgId": "20", "nodeId": "run" },
      { "msgId": "20", "nodeId": "run" }
    ],
    "nodeRuns": [
      { "flowId": "snap", "nodeId": "gh", "ok": true, "inCount": 3, "outCount": 3, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "snap", "nodeId": "inbox", "ok": true, "inCount": 3, "outCount": 3, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "snap", "nodeId": "run", "ok": true, "inCount": 3, "outCount": 1, "dropCount": 2, "err": "", "durMs": 0 }
    ]
  }
}
