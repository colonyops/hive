{
  "name": "github-filter glob semantics, with the fail port left unwired",
  "why": "The glob dialect is load-bearing and unusual: '*' stops at a '/', and '[', ']' are literal characters rather than a character class. Anything that matched these patterns differently would silently change which items a deployed flow routes. An unwired fail port is how today's plain 'drop on fail' filter is expressed.",
  "flow": {
    "id": "globs",
    "name": "Globs",
    "enabled": true,
    "nodes": [
      { "id": "src", "type": "sources.github", "kind": "search", "query": "is:open" },
      {
        "id": "keep",
        "type": "github-filter",
        "repos": ["acme/*"],
        "exclude_authors": ["*[bot]"],
        "types": ["pr"]
      },
      { "id": "inbox", "type": "feed" }
    ],
    "wires": [
      { "from": "src", "to": "keep" },
      { "from": "keep", "out": 0, "to": "inbox" }
    ]
  },
  "batch": [
    {
      "ID": "1", "Key": "a", "Topic": "source:globs/src", "Ts": 1, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "search",
      "Payload": { "repo": "acme/app", "author": "Alice", "kind": "pr" }
    },
    {
      "ID": "2", "Key": "b", "Topic": "source:globs/src", "Ts": 2, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "search",
      "Payload": { "repo": "other/app", "author": "alice", "kind": "pr" }
    },
    {
      "ID": "3", "Key": "c", "Topic": "source:globs/src", "Ts": 3, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "search",
      "Payload": { "repo": "acme/app", "author": "dependabot[bot]", "kind": "pr" }
    },
    {
      "ID": "4", "Key": "d", "Topic": "source:globs/src", "Ts": 4, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "search",
      "Payload": { "repo": "acme/app", "author": "bob", "kind": "issue" }
    },
    {
      "ID": "5", "Key": "e", "Topic": "source:globs/src", "Ts": 5, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "search",
      "Payload": { "repo": "acme/sub/app", "author": "bob", "kind": "pr" }
    }
  ],
  "expected": {
    "consumer": "globs",
    "upToOffset": 5,
    "outputs": [
      {
        "sink": { "kind": "feed", "targetId": "globs/inbox" },
        "key": "a",
        "payload": { "repo": "acme/app", "author": "Alice", "kind": "pr" },
        "sourceKind": "github",
        "sourceScope": "search",
        "sourceTopic": "source:globs/src"
      }
    ],
    "feedSnapshots": [],
    "discards": [
      { "msgId": "2", "nodeId": "keep" },
      { "msgId": "3", "nodeId": "keep" },
      { "msgId": "4", "nodeId": "keep" },
      { "msgId": "5", "nodeId": "keep" }
    ],
    "nodeRuns": [
      { "flowId": "globs", "nodeId": "src", "ok": true, "inCount": 5, "outCount": 5, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "globs", "nodeId": "keep", "ok": true, "inCount": 5, "outCount": 1, "dropCount": 4, "err": "", "durMs": 0 },
      { "flowId": "globs", "nodeId": "inbox", "ok": true, "inCount": 1, "outCount": 1, "dropCount": 0, "err": "", "durMs": 0 }
    ]
  }
}
