{
  "name": "publish-message dedups on the occurrence, create-task on the item, and neither fires from a snapshot",
  "why": "A published message reports an event, so it carries the occurrence key and every update publishes. A task is work that should exist once per item, so it carries only the item key, like a launch. A snapshot re-states items already seen, so it is dropped before both terminals.",
  "flow": {
    "id": "auto",
    "name": "Auto",
    "enabled": true,
    "nodes": [
      { "id": "src", "type": "sources.github", "kind": "notifications" },
      { "id": "p", "type": "publish-message", "topic": "deploys", "message": "{{ .Payload.repo }}" },
      { "id": "t", "type": "create-task", "title": "Look at {{ .Payload.repo }}" }
    ],
    "wires": [
      { "from": "src", "to": "p" },
      { "from": "src", "to": "t" }
    ]
  },
  "batch": [
    {
      "ID": "1", "Key": "k1", "Topic": "source:auto/src", "Ts": 1, "Snapshot": null,
      "SourceKind": "github", "SourceScope": "notifications", "OccurrenceKey": "oc-1",
      "Payload": { "repo": "acme/api" }
    },
    {
      "ID": "2", "Key": "", "Topic": "source:auto/src", "Ts": 2,
      "SourceKind": "github", "SourceScope": "notifications",
      "Payload": [{ "key": "k1", "payload": { "repo": "acme/api" } }],
      "Snapshot": [{ "key": "k1", "payload": { "repo": "acme/api" } }]
    }
  ],
  "expected": {
    "consumer": "auto",
    "upToOffset": 2,
    "outputs": [
      {
        "sink": { "kind": "publish", "targetId": "auto/p" },
        "key": "k1", "occurrenceKey": "oc-1", "payload": { "repo": "acme/api" }, "sourceKind": "github", "sourceScope": "notifications",
        "sourceTopic": "source:auto/src"
      },
      {
        "sink": { "kind": "task", "targetId": "auto/t" },
        "key": "k1", "payload": { "repo": "acme/api" }, "sourceKind": "github", "sourceScope": "notifications",
        "sourceTopic": "source:auto/src"
      }
    ],
    "feedSnapshots": [],
    "discards": [{ "msgId": "2", "nodeId": "p" }, { "msgId": "2", "nodeId": "t" }],
    "nodeRuns": [
      { "flowId": "auto", "nodeId": "src", "ok": true, "inCount": 2, "outCount": 2, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "auto", "nodeId": "p", "ok": true, "inCount": 2, "outCount": 1, "dropCount": 1, "err": "", "durMs": 0 },
      { "flowId": "auto", "nodeId": "t", "ok": true, "inCount": 2, "outCount": 1, "dropCount": 1, "err": "", "durMs": 0 }
    ]
  }
}
