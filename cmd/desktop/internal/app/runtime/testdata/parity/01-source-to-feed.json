{
  "name": "source relays to a feed, and a foreign topic is accounted for as unrouted",
  "why": "The baseline: a source node only ingests its own flow-qualified topic. A message belonging to another flow's source still has to be discarded rather than ignored, or the consumer offset could never advance past it.",
  "flow": {
    "id": "triage",
    "name": "Triage",
    "enabled": true,
    "nodes": [
      { "id": "gh", "type": "sources.github", "kind": "notifications" },
      { "id": "inbox", "type": "feed", "icon": "inbox" }
    ],
    "wires": [{ "from": "gh", "to": "inbox" }]
  },
  "batch": [
    {
      "ID": "10",
      "Key": "acme/app#1",
      "Topic": "source:triage/gh",
      "Ts": 1,
      "Payload": { "repo": "acme/app", "title": "one" },
      "Snapshot": null,
      "SourceKind": "github",
      "SourceScope": "notifications",
      "OccurrenceKey": "oc-1"
    },
    {
      "ID": "11",
      "Key": "acme/app#2",
      "Topic": "source:other/gh",
      "Ts": 2,
      "Payload": { "repo": "acme/app" },
      "Snapshot": null,
      "SourceKind": "github",
      "SourceScope": "notifications"
    }
  ],
  "expected": {
    "consumer": "triage",
    "upToOffset": 11,
    "outputs": [
      {
        "sink": { "kind": "feed", "targetId": "triage/inbox" },
        "key": "acme/app#1",
        "payload": { "repo": "acme/app", "title": "one" },
        "sourceKind": "github",
        "sourceScope": "notifications",
        "sourceTopic": "source:triage/gh"
      }
    ],
    "feedSnapshots": [],
    "discards": [{ "msgId": "11", "nodeId": "$unrouted" }],
    "nodeRuns": [
      { "flowId": "triage", "nodeId": "gh", "ok": true, "inCount": 1, "outCount": 1, "dropCount": 0, "err": "", "durMs": 0 },
      { "flowId": "triage", "nodeId": "inbox", "ok": true, "inCount": 1, "outCount": 1, "dropCount": 0, "err": "", "durMs": 0 }
    ]
  }
}
