{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,js,vue,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,vue,css,json}\"",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@vueuse/core": "^14.3.0",
    "@wailsio/runtime": "3.0.0-beta.21",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.17.2",
    "vue": "^3.2.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.123",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.11.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-icons": "23.0.1",
    "vite": "^8.0.5",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
