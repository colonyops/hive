FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends git tmux curl ca-certificates python3 systemd dbus-user-session openssh-client && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash hive
COPY . /bundle
USER hive
ENV XDG_RUNTIME_DIR=/tmp/hive-runtime
ENTRYPOINT ["python3", "/bundle/test.py"]
