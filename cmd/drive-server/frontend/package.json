  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.151",
    "@iconify-json/material-symbols": "1.2.97",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-icons": "23.0.1",
