FROM golang:1.27.3-bookworm@sha256:21ade014faf952365b9ecbd8dbdb87176fbacb82fac9fb132d9f2a7b8cc3f132 AS gobase

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Go toolchain
COPY --from=gobase /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# Copy built binaries (supports multiple TARGETARCH values). The remote-drive
# tests run hive-drive-server.
ARG TARGETARCH
COPY --chmod=755 dist/hive_linux_${TARGETARCH}_*/hive /usr/local/bin/hive
COPY --chmod=755 dist/hive-drive-server_linux_${TARGETARCH}_*/hive-drive-server /usr/local/bin/hive-drive-server

# Signal to tests that they're running inside the integration container
ENV HIVE_INTEGRATION=1

WORKDIR /app

# Copy Go module files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy integration tests and the internal packages they exercise directly.
COPY internal/ ./internal/
COPY pkg/ ./pkg/
COPY test/integration/ ./test/integration/

CMD ["go", "test", "-v", "-tags", "integration", "-count=1", "./test/integration/..."]
