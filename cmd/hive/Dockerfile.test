FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries (supports multiple TARGETARCH values). The remote-drive
# tests run hive-drive-server.
ARG TARGETARCH
COPY --chmod=755 dist/hive_linux_${TARGETARCH}_*/hive /usr/local/bin/hive
COPY --chmod=755 dist/hive-drive-server_linux_${TARGETARCH}_*/hive-drive-server /usr/local/bin/hive-drive-server

# Signal to tests that they're running inside the integration container
ENV HIVE_INTEGRATION=1

# The tests compile on the host, like the binaries above, so they reuse the host's
# Go build cache instead of recompiling from nothing inside the image.
WORKDIR /app/test/integration
COPY test/integration/testdata/ ./testdata/
COPY --chmod=755 dist/integration.test ./integration.test

CMD ["./integration.test", "-test.v", "-test.count=1"]
