FROM golang:1.27.3-bookworm@sha256:21ade014faf952365b9ecbd8dbdb87176fbacb82fac9fb132d9f2a7b8cc3f132 AS gobase

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Go toolchain
COPY --from=gobase /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# Copy built hive binary (supports multiple TARGETARCH values)
ARG TARGETARCH
COPY dist/hive_linux_${TARGETARCH}_*/hive /usr/local/bin/hive
RUN chmod +x /usr/local/bin/hive

# Signal to tests that they're running inside the integration container
ENV HIVE_INTEGRATION=1

WORKDIR /app

# Copy Go module files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy integration tests and the internal packages they exercise directly.
COPY internal/ ./internal/
COPY pkg/ ./pkg/
COPY cmd/drive-server/ ./cmd/drive-server/
COPY test/integration/ ./test/integration/

# The drive server is a separate binary that the remote-drive tests run.
RUN go build -o /usr/local/bin/hive-drive-server ./cmd/drive-server

CMD ["go", "test", "-v", "-tags", "integration", "-count=1", "./test/integration/..."]
